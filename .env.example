# URL base del API (incluir /api al final). Obligatorio en producción si el backend está en otro dominio.
# Ejemplo: https://tu-backend.railway.app/api
VITE_API_URL=

# URL del servidor Socket.IO (mismo host que el API, sin /api). Obligatorio en producción si el backend está en otro dominio.
# Ejemplo: https://tu-backend.railway.app
VITE_SOCKET_URL=

# Firebase (opcional; si no se definen, se usan valores por defecto de desarrollo)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
