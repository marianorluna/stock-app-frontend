# URL base del API (incluir /api al final).
# En desarrollo sin esta variable usa el proxy de Vite → /api
# Ejemplo: https://tu-backend.railway.app/api
VITE_API_URL=

# URL del servidor Socket.IO (mismo host que el API, sin /api).
# En desarrollo sin esta variable usa el proxy de Vite → /
# Ejemplo: https://tu-backend.railway.app
VITE_SOCKET_URL=

# Clave pública VAPID para notificaciones push.
# Debe coincidir exactamente con VAPID_PUBLIC_KEY del backend.
# Obtenerla ejecutando: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Firebase SDK web (cliente)
# Estas claves NO son secretos de servidor. Son públicas por diseño:
# el SDK web las necesita para identificar el proyecto desde el navegador.
# La seguridad real la dan las Firebase Security Rules y Firebase Auth.
# La API key debe tener restricción de dominio en Google Cloud Console:
#   → Credentials → edita la clave → HTTP referrers → solo tus dominios.
# Ref: https://firebase.google.com/docs/projects/api-keys
# ---------------------------------------------------------------------------
